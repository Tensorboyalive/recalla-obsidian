{
	"name": "recalla-obsidian",
	"version": "0.1.1",
	"description": "Obsidian plugin that makes your vault agent-readable by wrapping the recalla CLI.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"test": "tsx --test tests/ask.test.ts tests/binary-release.test.ts tests/runtime.test.ts"
	},
	"keywords": [
		"obsidian",
		"recalla",
		"mcp",
		"agent"
	],
	"author": "Tensorboyalive",
	"license": "Apache-2.0",
	"devDependencies": {
		"@types/node": "^20.11.0",
		"builtin-modules": "^3.3.0",
		"esbuild": "^0.28.1",
		"obsidian": "latest",
		"tsx": "^4.23.0",
		"typescript": "^5.4.0"
	}
}
